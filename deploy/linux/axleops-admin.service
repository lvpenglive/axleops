[Unit]
Description=AxleOps Admin — control plane & console
Documentation=https://github.com/lvpenglive/axleops
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
Group={{GROUP}}
WorkingDirectory={{PREFIX}}/admin
ExecStart={{PREFIX}}/admin/axleops-admin
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{PREFIX}}/admin

[Install]
WantedBy=multi-user.target
