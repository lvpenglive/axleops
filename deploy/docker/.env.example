# Copy to deploy/docker/.env and change secrets before first start.
#   cp deploy/docker/.env.example deploy/docker/.env

ADMIN_PORT=9000
AGENT_PORT=9100
PROXY_PORT=9200

ADMIN_TOKEN=change-me-admin-token
ADMIN_SEED_USER=admin
ADMIN_SEED_PASSWORD=change-me-admin
ADMIN_SESSION_TTL_HOURS=24

AGENT_TOKEN=change-me-agent-token
AGENT_WATCHDOG=true

PROXY_TOKEN=change-me-proxy-token
PROXY_TIMEOUT_SECS=120

# Host directory mounted into agent at /apps (JAR / scripts)
APPS_DIR=./deploy/docker/apps
