# Build context: repository root
#   docker build -f deploy/docker/Dockerfile.agent -t axleops-agent .
FROM rust:1-bookworm AS builder
WORKDIR /src
COPY axleops-agent /src/axleops-agent
WORKDIR /src/axleops-agent
RUN cargo build --release

FROM debian:bookworm-slim
# JRE so jar services can run inside this container (mount host JARs to /apps).
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl openjdk-17-jre-headless \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /src/axleops-agent/target/release/axleops-agent /app/axleops-agent
COPY axleops-agent/config.example.toml /app/config.example.toml
ENV AXLEOPS_BIND=0.0.0.0:9100 \
    AXLEOPS_DATA_DIR=/app/data
EXPOSE 9100
VOLUME ["/app/data", "/apps"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1:9100/health >/dev/null || exit 1
CMD ["./axleops-agent"]
