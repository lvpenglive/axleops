# Build context: repository root
#   docker build -f deploy/docker/Dockerfile.proxy -t axleops-proxy .
FROM rust:1-bookworm AS builder
WORKDIR /src
COPY axleops-proxy /src/axleops-proxy
WORKDIR /src/axleops-proxy
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /src/axleops-proxy/target/release/axleops-proxy /app/axleops-proxy
COPY axleops-proxy/config.example.toml /app/config.example.toml
ENV AXLEOPS_PROXY_BIND=0.0.0.0:9200 \
    AXLEOPS_PROXY_DATA_DIR=/app/data
EXPOSE 9200
VOLUME ["/app/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1:9200/health >/dev/null || exit 1
CMD ["./axleops-proxy"]
